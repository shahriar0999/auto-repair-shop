---
import { networks } from '@/lib/networks';
const opts = Object.entries(networks).map(([key, v]) => ({ key, label: v.short }));
---
<div class="search" data-search>
  <div class="seg" role="group" aria-label="Choose which shops to search">
    <button type="button" data-net="all" aria-pressed="true">All</button>
    {opts.map((o) => <button type="button" data-net={o.key} aria-pressed="false">{o.label}</button>)}
  </div>
  <form class="counter" role="search" autocomplete="off">
    <svg class="search-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
    <input type="text" role="combobox" aria-expanded="false" aria-controls="search-list" aria-autocomplete="list"
      placeholder="Search a city or shop name" aria-label="Search a city or shop name" />
    <button class="btn" type="submit">Search</button>
  </form>
  <ul class="results" id="search-list" role="listbox" hidden></ul>
</div>
<script>
  type Idx = { n: Record<string, string>; c: [string, string, number, string][]; s: [string, string, string, string][] };
  type Item = { label: string; sub: string; href: string; kind: string };
  const root = document.querySelector<HTMLElement>('[data-search]')!;
  const input = root.querySelector('input')!;
  const list = root.querySelector<HTMLUListElement>('.results')!;
  let data: Idx | null = null, items: Item[] = [], active = -1, net = 'all';

  const load = async () => (data ??= (await (await fetch('/search-index.json')).json()) as Idx);
  const esc = (s: string) => s.toLowerCase();

  function mark(text: string, q: string) {
    const f = document.createDocumentFragment();
    const i = q ? esc(text).indexOf(q) : -1;
    if (i < 0) { f.append(text); return f; }
    const m = document.createElement('mark'); m.textContent = text.slice(i, i + q.length);
    f.append(text.slice(0, i), m, text.slice(i + q.length));
    return f;
  }
  function open(v: boolean) { list.hidden = !v; input.setAttribute('aria-expanded', String(v)); if (!v) active = -1; }
  function setActive(n: number) {
    active = (n + items.length) % items.length;
    list.querySelectorAll('li').forEach((li, i) => li.setAttribute('aria-selected', String(i === active)));
    input.setAttribute('aria-activedescendant', `opt-${active}`);
    list.children[active]?.scrollIntoView({ block: 'nearest' });
  }
  async function render() {
    const d = await load(); const q = esc(input.value.trim());
    const inNet = (x: any[]) => net === 'all' || x[3] === net;
    let cities = d.c.filter(inNet);
    if (q) cities = cities.filter((x) => esc(x[0]).includes(q)).sort((a, b) => +!esc(a[0]).startsWith(q) - +!esc(b[0]).startsWith(q));
    else if (net === 'all') cities = Object.keys(d.n).flatMap((k) => cities.filter((x) => x[3] === k).slice(0, 3));
    const shops = q.length > 1 ? d.s.filter(inNet).filter((x) => esc(x[0]).includes(q)).slice(0, 5) : [];
    items = [
      ...cities.slice(0, 6).map((x) => ({ label: x[0], sub: `${x[2]} ${x[2] === 1 ? 'location' : 'locations'}`, href: x[1], kind: d.n[x[3]] })),
      ...shops.map((x) => ({ label: x[0], sub: x[1], href: x[2], kind: d.n[x[3]] })),
    ];
    list.replaceChildren();
    if (!items.length) {
      const li = document.createElement('li'); li.className = 'empty';
      li.textContent = `No match for "${input.value.trim()}". Try a nearby city or another network.`;
      list.append(li); open(true); return;
    }
    items.forEach((it, i) => {
      const li = document.createElement('li'); li.id = `opt-${i}`; li.role = 'option'; li.setAttribute('aria-selected', 'false');
      const a = document.createElement('span'); a.className = 'r-main'; a.append(mark(it.label, q));
      const b = document.createElement('span'); b.className = 'r-sub'; b.textContent = it.sub;
      const k = document.createElement('span'); k.className = 'r-kind'; k.textContent = it.kind;
      li.append(a, b, k);
      li.addEventListener('mousedown', (e) => { e.preventDefault(); location.href = it.href; });
      list.append(li);
    });
    open(true);
  }
  root.querySelectorAll<HTMLButtonElement>('[data-net]').forEach((b) => {
    b.addEventListener('mousedown', (e) => e.preventDefault()); // keep focus in the search box
    b.addEventListener('click', () => {
      net = b.dataset.net!;
      root.querySelectorAll('[data-net]').forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      window.dispatchEvent(new CustomEvent('networkchange', { detail: net }));
      if (!list.hidden) render();
    });
  });
  input.addEventListener('focus', render);
  input.addEventListener('input', render);
  input.addEventListener('blur', () => setTimeout(() => open(false), 100));
  input.addEventListener('keydown', (e) => {
    if (list.hidden && e.key === 'ArrowDown') { render(); return; }
    if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
    else if (e.key === 'Escape') open(false);
  });
  root.querySelector('form')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const pick = items[active >= 0 ? active : 0];
    if (pick) location.href = pick.href;
  });
</script>
