---
import Base from '@/layouts/Base.astro';
---
<Base title="Something Went Wrong | Repair Finder" description="Something went wrong on our side. Please try again in a moment." noindex>
  <section class="hero">
    <p class="muted">Error 500</p>
    <h1>Something went wrong</h1>
    <p>We hit a problem on our side. Please try again in a moment. If it keeps happening, let us know on the contact page.</p>
    <div class="actions">
      <a class="btn" href="/">Back to home</a>
      <a class="btn ghost" href="/contact/">Contact us</a>
    </div>
  </section>
</Base>
